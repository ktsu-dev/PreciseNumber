<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- BenchmarkDotNet finds the project that produced a benchmark assembly by matching the
         assembly name against .csproj file names. ktsu.Sdk would otherwise name the output
         ktsu.PreciseNumber.Benchmarks, which matches no project file. -->
    <AssemblyName>PreciseNumber.Benchmarks</AssemblyName>
    <RootNamespace>ktsu.PreciseNumber.Benchmarks</RootNamespace>
    <!-- KTSU0001 asks every project to reference Polyfill. This one targets the current
         framework only, so it has nothing to polyfill, and the library already exposes its
         internal copy here through InternalsVisibleTo - referencing it again would make
         every polyfilled member ambiguous. -->
    <NoWarn>$(NoWarn);KTSU0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PreciseNumber\PreciseNumber.csproj" />
  </ItemGroup>

</Project>
